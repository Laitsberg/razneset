# ============================================================
#  СЕРВЕР ДЛЯ RAILWAY: треки плейлиста по ссылке
#  ------------------------------------------------------------
#  Ставить нечего: сервер обходится тем, что есть в Node. В образ
#  кладём только его и lib/ — модель (data/) раздаёт GitHub Pages,
#  серверу она не нужна, и её ежедневные обновления не требуют
#  пересборки.
# ============================================================
FROM node:22-alpine

WORKDIR /app
COPY package.json ./
COPY lib/ ./lib/
COPY server/ ./server/

ENV NODE_ENV=production
EXPOSE 3000

CMD ["node", "server/index.mjs"]
